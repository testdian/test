# pre 环境 env 文件
REACT_APP_API_URL=http://10.2.11.19/api

# 文件上传的地址
REACT_APP_API_FILE_UPLOAD_URL=/file/fileapi/upload/randomPath

# 随机文件名 - 文件上传的地址
REACT_APP_API_FILE_UPLOAD_RANDOMNAME_URL=/file/fileapi/upload/randomPath

# 文件上传的地址 - 漏洞检查 /file/fileapi/token/upload 基克纳去掉
REACT_APP_API_FILE_UPLOAD_URL_SALE=/file/fileapi/upload/randomPath

# 随机文件名 - 文件上传的地址 - 漏洞检查 /file/fileapi/token/upload/randomName 基克纳去掉
REACT_APP_API_FILE_UPLOAD_RANDOMNAME_URL_SALE=/file/fileapi/upload/randomPath

# 模板文件域名
REACT_APP_API_TEMPLATE_FILE_URL=https://bc-files-test.carbonstop.com