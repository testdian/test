    "stylelint-config-standard": "^29.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.7.0",
    "stylelint-less": "^1.0.6",
    "stylelint-order": "^5.0.0",
    "swaggie-beta": "^0.7.9",
    "ts-node": "^10.9.1",
    "typescript": "5.1.5",
