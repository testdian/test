  "components": {
    "schemas": {
      "ApiResultFileUpload": {
        "required": ["code", "data", "msg"],
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "结果码",
            "format": "int32",
            "example": 200
          },
          "msg": {
            "type": "string",
            "description": "返回信息",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/FileUpload"
          }
        },
        "description": "通用接口返回对象"
      },
      "FileUpload": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "description": "文件名"
          },
          "filePath": {
            "type": "string",
            "description": "filePath"
          },
          "url": {
            "type": "string",
            "description": "外网url"
          },
          "internalUrl": {
            "type": "string",
            "description": "内网url"
          }
        },
        "description": "FileUpload"
      },
      "FileReq": {
        "required": ["file"],
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "文件url"
          },
          "fileName": {
            "type": "string",
            "description": "文件名。不传则使用url自身文件名"
          }
        },
        "description": "FileReq"
      },
      "ApiResultListEnumResp": {
        "required": ["code", "data", "msg"],
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "结果码",
            "format": "int32",
            "example": 200
          },
          "msg": {
            "type": "string",
            "description": "返回信息",
            "example": "success"
          },
          "data": {
            "type": "array",
            "description": "返回数据",
            "items": {
              "$ref": "#/components/schemas/EnumResp"
            }
          }
        },
        "description": "通用接口返回对象"
      },
      "EnumResp": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "subList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumResp"
            }
          },
          "score": {
            "type": "string"
          }
        },
        "description": "返回数据"
      }
    },
    "securitySchemes": {
